# Meta / Instagram
IG_VERIFY_TOKEN=choose_any_random_string_here
IG_PAGE_ACCESS_TOKEN=your_page_access_token_from_meta
IG_APP_SECRET=your_app_secret_from_meta

# LLM providers - add as many keys as you want, comma-separated, no spaces needed.
# Order used: all Gemini keys first (left to right), then all Groq keys.
GEMINI_API_KEYS=gemini_key_1,gemini_key_2,gemini_key_3
GROQ_API_KEYS=groq_key_1,groq_key_2

# App
# Local testing: leave as-is (SQLite file). Production/persistent: paste your
# Supabase Postgres connection string here as-is, e.g.
# postgresql://postgres:yourpassword@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./memory/chat.db
LOG_LEVEL=INFO
MAX_HISTORY_MESSAGES=20
